# このファイルを .env にコピーして値を埋めてください（.env は git 管理対象外）
# cp .env.example .env

# Supabase プロジェクトの Project URL（Settings > API）
SUPABASE_URL=

# Supabase の anon / publishable key（Settings > API）
SUPABASE_ANON_KEY=

# CLI がログインに使う自分のアカウント（apps/cli 用）
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# メモ欄暗号化用の対称鍵（Base64, 32バイト）。生成例:
#   node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
# ダッシュボード（service_role 接続）から平文を読めなくするためのものであり、
# クライアントサイドの鍵なので秘匿性には限界がある（README のセキュリティ節を参照）。
MEMO_ENCRYPTION_KEY=
